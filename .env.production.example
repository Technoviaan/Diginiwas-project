# Production settings. On the server:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   nano .env.production
# Never commit .env.production or copy your local .env to the server.

# --- Used by docker compose ---
# The domain the API is served on. Its DNS A record must point at this server.
DOMAIN=api.example.com

# --- The API ---
OPENAI_API_KEY=
MODEL=gpt-4o-mini
# Lower is more factual. Recommendations should stick to listing data.
TEMPERATURE=0.3

# The origins allowed to call the API from a browser, e.g. your website.
CORS_ORIGINS=["https://diginiwas.com","https://www.diginiwas.com"]

# Chat messages per client IP per minute. Each one costs OpenAI tokens.
RATE_LIMIT_PER_MINUTE=20

# Link for each card's "View Property" button. Uncomment once you know the
# real URL pattern; {id} becomes the listing ID, e.g. DW-1003.
# PROPERTY_URL_TEMPLATE=https://diginiwas.com/property/{id}

# Web search, for locality sources and the quoted locality trend on the
# property snapshot. One key from serper.dev; without it both are simply off.
SERPER_API_KEY=

# Required: the DigiNiwas backend the chatbot reads listings from. The API
# refuses to start without it.
PROPERTIES_API_BASE_URL=https://backend-diginiwas.onrender.com

# Defaults are fine for these; see .env.example for the full list.
# MAX_PROPERTY_RESULTS=6
