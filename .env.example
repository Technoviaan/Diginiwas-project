# Copy to .env and fill in.
OPENAI_API_KEY=sk-...

# Model
MODEL=gpt-4o
MAX_TOKENS=4096
TEMPERATURE=0.7
# REASONING_EFFORT=medium
# OPENAI_BASE_URL=http://localhost:11434/v1

# Conversation
HISTORY_WINDOW=24
MAX_TOOL_ROUNDS=3
# ALLOW_SYSTEM_PROMPT_OVERRIDE=false
# SYSTEM_PROMPT=...   (default lives in app/assistant/prompts.py)
# MAX_SESSIONS=10000
# LOG_LEVEL=INFO

# DigiNiwas properties API
PROPERTIES_API_BASE_URL=https://backend-diginiwas.onrender.com
PROPERTIES_API_TIMEOUT=60
MAX_PROPERTY_RESULTS=6
# PROPERTY_URL_TEMPLATE=https://diginiwas.com/property/{id}

# Property snapshot (GET /v1/properties/{id}/snapshot)
# COMPARABLE_RADIUS_KM=3.0
# COMPARABLE_AREA_TOLERANCE=0.25
# MAX_COMPARABLES=30
# Web search for locality sources and quoted trends: serper (default), google or brave.
# SEARCH_PROVIDER=serper
# Serper: one key from serper.dev - Google's results, 2,500 free queries on signup.
# SERPER_API_KEY=
# Brave: one key from api-dashboard.search.brave.com (paid; card required).
# BRAVE_SEARCH_API_KEY=
# Google: both of the next two are needed.
# The key needs the Custom Search API enabled; the id is a Programmable
# Search Engine's `cx` value.
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_ENGINE_ID=
# LOCALITY_SOURCES_LIMIT=3
# Rental yield: months a year a rental is assumed to sit empty, for net yield.
# RENTAL_VACANCY_MONTHS=1
# Quote a locality's average rent from the web when comparable rentals are too few.
# WEB_RENT_ENABLED=true
# Chatbot: answer "average land price in <area>?" with published, source-quoted rates.
# AREA_RATES_ENABLED=true
# Quote a locality trend from a web page, when a search snippet states one.
# Needs the two Google settings above. The figure is a citation, not a
# measurement: it ships with its quote, its source and "Low" confidence.
# WEB_TREND_ENABLED=false

# Server
# CORS_ORIGINS=["https://diginiwas.com"]
# RATE_LIMIT_PER_MINUTE=20
